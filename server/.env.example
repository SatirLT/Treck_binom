# Binom Tracker Configuration
BINOM_URL=https://your-binom-domain.com
BINOM_API_KEY=your_api_key_here

# Server Configuration
PORT=3000
BASE_URL=https://your-server-domain.com

# Campaign Settings
CAMPAIGN_ID=1
LANDING_ID=1

# Apphud Integration
# Secret token for validating Apphud webhook requests
# Set the same value in Apphud Dashboard → Connection Builder → Header Value
APPHUD_SECRET_TOKEN=your_apphud_secret_token
